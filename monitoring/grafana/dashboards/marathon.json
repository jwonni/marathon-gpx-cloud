  {
   "id": 5,
   "type": "timeseries",
   "title": "단계별 평균 처리 시간",
   "description": "최근 15분 평균. stage=ocr 과 ocr_service 의 차이 = 컨테이너 간 HTTP 비용",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (stage) (increase(marathon_stage_seconds_sum[15m])) / sum by (stage) (increase(marathon_stage_seconds_count[15m]))",
     "legendFormat": "{{stage}}",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(marathon_ocr_service_seconds_sum[15m])) / sum(increase(marathon_ocr_service_seconds_count[15m]))",
     "legendFormat": "ocr_service (서비스 내부)",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "pointSize": 5,
      "showPoints": "always",
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
