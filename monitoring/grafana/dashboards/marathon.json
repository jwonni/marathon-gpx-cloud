      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "up{job=\"app\"}",
     "legendFormat": "앱",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
