{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConsumeJobsQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "arn:aws:sqs:ap-northeast-2:507138241931:marathon-jobs"
    },
    {
      "Sid": "ReadInputs",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::marathon-gpx-jobs-507138241931/inputs/*"
    },
    {
      "Sid": "WriteResults",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::marathon-gpx-jobs-507138241931/results/*"
    }
  ]
}
