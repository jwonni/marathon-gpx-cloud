{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadModelWeightsOnly",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::marathon-gpx-artifacts-507138241931/models/*"
    },
    {
      "Sid": "ListModelsPrefixOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::marathon-gpx-artifacts-507138241931",
      "Condition": {
        "StringLike": { "s3:prefix": ["models/", "models/*"] }
      }
    }
  ]
}
