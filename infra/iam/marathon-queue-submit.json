{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendJobs",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:sqs:ap-northeast-2:507138241931:marathon-jobs"
    },
    {
      "Sid": "QueueStatus",
      "Effect": "Allow",
      "Action": "sqs:GetQueueAttributes",
      "Resource": [
        "arn:aws:sqs:ap-northeast-2:507138241931:marathon-jobs",
        "arn:aws:sqs:ap-northeast-2:507138241931:marathon-jobs-dlq"
      ]
    },
    {
      "Sid": "UploadInputs",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::marathon-gpx-jobs-507138241931/inputs/*"
    },
    {
      "Sid": "ReadResults",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::marathon-gpx-jobs-507138241931/results/*"
    },
    {
      "Sid": "ListResults",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::marathon-gpx-jobs-507138241931",
      "Condition": {
        "StringLike": { "s3:prefix": ["results/", "results/*"] }
      }
    }
  ]
}
